# Coach Running — model keys.
# Model metadata (base URLs, model names, roles) lives in models.json.
# Only the secrets live here. The app works offline without any key.
#
# Model keys — never commit real keys. `.env` is gitignored.
# `models.json` references these variable names (via "apiKeyEnv").
ALBERT_API_KEY=
GEMMA_API_KEY=

# Optional default model id from models.json (overrides its "default"):
# COACH_LLM_DEFAULT=albert-qwen

# Shared request settings:
COACH_LLM_TIMEOUT_S=300
COACH_LLM_MAX_TOKENS=900
COACH_LLM_TEMPERATURE=0.4

# ---------------------------------------------------------------------------
# Legacy single-model configuration (used only if models.json is absent).
# Local Ollama needs no key:
# COACH_LLM_BASE_URL=http://127.0.0.1:11434/v1
# COACH_LLM_MODEL=qwen2.5:7b-instruct
# COACH_LLM_API_KEY=
#
# Cloud example (OpenAI-compatible):
# COACH_LLM_BASE_URL=https://api.openai.com/v1
# COACH_LLM_MODEL=gpt-4o-mini
# COACH_LLM_API_KEY=sk-...
